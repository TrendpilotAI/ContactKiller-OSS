# SurrealDB (local development: see compose.yaml and docs/DEVELOPMENT.md)
SURREALDB_URL=http://127.0.0.1:8000
SURREALDB_NAMESPACE=contactkiller
SURREALDB_DATABASE=contactkiller

# Encrypts provider OAuth tokens before they are stored. 32 random bytes, base64.
# Generate your own: openssl rand -base64 32
CONTACTKILLER_TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Account creation is OFF by default, and the database enforces it: SurrealDB's
# sign-up clause refuses to run unless its own setting is on. This variable is the
# source of truth for that setting; `bun run db:migrate` copies it into the database.
# To create the first user: set this to true, run `bun run db:migrate`, restart the
# dev server, create the account on /login, then set it back to false and re-run
# `bun run db:migrate`.
CONTACTKILLER_ALLOW_SIGNUP=false

# Google People API (read-only development OAuth client)
GOOGLE_CLIENT_ID=your-development-google-client-id
GOOGLE_CLIENT_SECRET=your-development-google-client-secret

# Local application origin; must match the Google OAuth redirect configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
