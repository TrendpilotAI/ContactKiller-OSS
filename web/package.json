{
  "name": "contactkiller",
  "version": "0.1.0",
  "description": "Experimental provenance-first contact reconciliation web prototype",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrendpilotAI/ContactKiller-OSS.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/TrendpilotAI/ContactKiller-OSS/issues"
  },
  "homepage": "https://github.com/TrendpilotAI/ContactKiller-OSS#readme",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun --env-file=.env.local --env-file=compose.env scripts/migrate.ts up",
    "db:rollback": "bun --env-file=.env.local --env-file=compose.env scripts/migrate.ts down"
  },
  "dependencies": {
    "googleapis": "^170.0.0",
    "libphonenumber-js": "^1.12.34",
    "next": "15.5.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "surrealdb": "2.0.10",
    "vcf": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "glob": "10.5.0",
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  }
}
