# Review ownership for the files that gate what the public tracker may contain.
# TrendpilotAI is the repository owner account (a user account, not an org, so
# there are no teams to use). Listing a path here only takes effect when branch
# protection requires code-owner reviews, which is the repository owner's setting.
/.github/workflows/**           @TrendpilotAI
/.github/CODEOWNERS             @TrendpilotAI
/scripts/check-*                @TrendpilotAI
/scripts/beads-expected-ids.sh  @TrendpilotAI
/scripts/beads-guard.sh         @TrendpilotAI
/scripts/beads-history-baseline.txt @TrendpilotAI
/scripts/bd-push.sh             @TrendpilotAI
/.beads/config.yaml             @TrendpilotAI
/.beads/metadata.json           @TrendpilotAI
/.beads/interactions.jsonl      @TrendpilotAI
/PUBLIC_RELEASE_MANIFEST.json   @TrendpilotAI
